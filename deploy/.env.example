# Skopiuj do .env w folderze appki na serwerze (cp deploy/.env.example .env) i uzupełnij.
# .env jest w .gitignore i .dockerignore. Bez klucza OpenAI API: nie dopisuj OPENAI_API_KEY ani CODEX_API_KEY.

# Domena panelu (na Hostingerze darmowa srvXXXXXX.hstgr.cloud). Caddy wystawia dla niej certyfikat.
RADAR_DOMAIN=srv123456.hstgr.cloud

# Pełny adres panelu. Żądania POST/DELETE przechodzą tylko z Origin równym temu adresowi.
RADAR_PUBLIC_URL=https://srv123456.hstgr.cloud
# Wariant Tailscale (WIZARD F4d): RADAR_PUBLIC_URL=https://NAZWA-SERWERA.TAILNET.ts.net (z `tailscale status`),
# RADAR_DOMAIN wtedy nieużywane.

# Hash hasła do panelu (scrypt z node:crypto, bez zależności). Bez niego appka nie startuje.
# Format: scrypt$N$r$p$salt_b64$hash_b64, np. N=16384, r=8, p=1, sól 16 bajtów, hash 64 bajty.
# Agent pyta o hasło polem formularza (nie w czacie) i liczy hash lokalnie, hasło podaje skryptowi
# przez stdin, nie w argumentach komendy. Wartość w POJEDYNCZYCH cudzysłowach, bo zawiera znaki $:
# bez nich Docker Compose bierze sól i hash za nazwy zmiennych i po cichu obcina wartość. Np.:
# RADAR_PANEL_PASSWORD_HASH='scrypt$16384$8$1$c29sLWJhc2U2NA==$aGFzaC1iYXNlNjQ...'
RADAR_PANEL_PASSWORD_HASH=

# Sekret do podpisu cookie sesji, losowy: openssl rand -hex 32
RADAR_SESSION_SECRET=

# Opcja: bezpiecznik tury agenta w ms (domyślnie i maksymalnie 600000 = 10 min).
# Do testu przerwania w F6 ustaw np. 20000, potem przywróć.
# RADAR_RUN_TIMEOUT_MS=600000
